{
  "name": "studio-x-photography",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "node scripts/db-guard.mjs && prisma migrate dev",
    "db:deploy": "node scripts/db-guard.mjs && prisma migrate deploy",
    "db:seed": "node scripts/db-guard.mjs && tsx prisma/seed.ts",
    "db:reset": "node scripts/db-guard.mjs && prisma migrate reset",
    "provision-owner": "tsx scripts/provision-owner.ts",
    "verify-env": "tsx scripts/verify-env.ts"
  },
  "dependencies": {
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.1.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "@types/react": "^19.1.0",
    "@types/node": "^22.0.0",
    "@playwright/test": "^1.56.0",
    "@types/react-dom": "^19.1.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@eslint/eslintrc": "^3.3.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.5.0",
    "prettier": "^3.6.0",
    "vitest": "^3.2.0",
    "tsx": "^4.20.0",
    "prisma": "^6.17.0"
  }
}
