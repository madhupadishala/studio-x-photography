# REQUIRED local demo: use a dedicated dev database only; NEVER production
DATABASE_URL=
DIRECT_URL=
# Alternative to DIRECT_URL: DATABASE_URL_UNPOOLED=
# REQUIRED local demo: at least 32 characters
NEXTAUTH_SECRET=
# REQUIRED local demo; Preview derives from VERCEL_URL when unset
NEXTAUTH_URL=http://localhost:3000
DB_TARGET=dev
# One-time owner provisioning, never commit real credentials
OWNER_EMAIL=
OWNER_PASSWORD=
# Studio identity; blank contacts are labeled demo
STUDIO_NAME=Studio X
STUDIO_PHONE=
STUDIO_WHATSAPP_NUMBER=
STUDIO_ADDRESS=Dilsukhnagar, Hyderabad, Telangana, India
INSTAGRAM_URL=
YOUTUBE_URL=
GOOGLE_MAPS_URL=
SHOW_SYNTHETIC_MEDIA=true
DESIGN_REVIEW_MODE=false
WHATSAPP_CLOUD_ENABLED=false
INSTAGRAM_API_ENABLED=false
ANALYTICS_ENABLED=false
# S3-compatible storage (optional; not provisioned)
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# WhatsApp Cloud API (optional)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Instagram API (optional)
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
# Analytics and ads (optional)
GA4_MEASUREMENT_ID=
META_PIXEL_ID=
META_CAPI_TOKEN=
GOOGLE_ADS_ID=
GOOGLE_ADS_CONVERSION_LABEL=
# Email and abuse prevention (optional)
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=
RATE_LIMIT_STORE_URL=
DATA_RETENTION_DAYS=365
