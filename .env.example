# Database: use a least-privilege PostgreSQL app role with RLS enabled.
DATABASE_URL=
SESSION_SECRET=
OTP_PEPPER=
PREVIEW_HOSTS=studio-x-blush.vercel.app
PREVIEW_TENANT_SLUG=

# Cloudflare R2 (private bucket; expose assets through a controlled public domain/CDN).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE=

# Meta / WhatsApp Cloud API. Use only official app credentials and approved templates.
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OTP_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_API_VERSION=v23.0
CRON_SECRET=

# OAuth providers
INTEGRATION_ENCRYPTION_KEY=
META_GRAPH_API_VERSION=v27.0
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=https://studio-x-blush.vercel.app/api/integrations/instagram/callback
INSTAGRAM_OAUTH_SCOPES=instagram_business_basic,instagram_business_manage_comments,instagram_business_manage_messages
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=https://studio-x-blush.vercel.app/api/integrations/youtube/callback
YOUTUBE_OAUTH_SCOPES=https://www.googleapis.com/auth/youtube.readonly
META_EMBEDDED_SIGNUP_CONFIG_ID=
NEXT_PUBLIC_META_APP_ID=
NEXT_PUBLIC_META_EMBEDDED_SIGNUP_CONFIG_ID=

# RunGrow Workforce v1 adapter (configure only in the deployment secret store)
RUNGROW_WORKFORCE_HMAC_SECRET=
RUNGROW_WORKFORCE_WEBHOOK_URL=
